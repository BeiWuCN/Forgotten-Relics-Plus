<component name="ProjectRunConfigurationManager">
<!--
    runClient：开发客户端

    启动一个带本模组的 Minecraft 客户端，用于在游戏里验证物品、配方与研究页。

    为什么是 Application 而不是 Gradle 类型的配置：
      入口 net.neoforged.devlaunch.Main 就是 ModDevGradle 自己生成配置时用的入口，
      调试器直接挂在游戏 JVM 上，断点可以下在 Minecraft 与本模组的代码里。
      走 Gradle 任务会多一层 Gradle 进程，加载期与 mixin 相关的断点容易丢。

    为什么挂 Gradle.BeforeRunTask：
      PROGRAM_PARAMETERS / VM_PARAMETERS 指向 build\moddev\ 下的参数文件，
      由 prepare*Run 生成。挂成前置任务可保证：
        - 全新 clone、或 build\ 被删掉之后，点按钮依然能启动
        - 改过 build.gradle 的 runs 块之后参数会自动跟上

    为什么放在 .run\ 而不是让 IDEA 自己生成：
      ModDevGradle 通过 idea-ext 把配置写进 .idea\workspace.xml，而该文件被
      .gitignore 忽略（.idea\ 整目录）。一旦 workspace.xml 损坏或被清理，
      配置就会丢失且无法从 git 恢复。.run\*.run.xml 是 IDEA 的共享配置格式，
      会进版本库，因此不会再丢。

    【重要】本项目路径含空格（F:\Deepseek Harness\...），因此：
      1. @参数文件 的路径必须加引号：@&quot;...&quot;
      2. -Dfml.modFolders 的整段也必须加引号
      这与 ModDevGradle 生成的 build\moddev\run*.cmd 里的写法完全一致；
      不加引号 JVM 会把路径截断到第一个空格，报
      "Error: could not open 'F:\Deepseek'"。
      XML 属性里用 &quot; 表示双引号。
  -->
  <configuration default="false" name="runClient" type="Application" factoryName="Application">
    <option name="MAIN_CLASS_NAME" value="net.neoforged.devlaunch.Main" />
    <module name="ForgottenRelicsUnofficial.main" />
    <option name="PROGRAM_PARAMETERS" value="@&quot;$PROJECT_DIR$/build/moddev/clientRunProgramArgs.txt&quot;" />
    <option name="VM_PARAMETERS" value="@&quot;$PROJECT_DIR$/build/moddev/clientRunVmArgs.txt&quot; &quot;-Dfml.modFolders=forgotten_relics%%$PROJECT_DIR$/build/classes/java/main;forgotten_relics%%$PROJECT_DIR$/build/resources/main&quot;" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$/run" />
    <method v="2">
      <option name="Gradle.BeforeRunTask" enabled="true" tasks="prepareClientRun" externalProjectPath="$PROJECT_DIR$" vmOptions="" scriptParameters="" />
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
